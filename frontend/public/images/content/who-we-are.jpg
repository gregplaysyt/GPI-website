					<style type="text/css" id="wp-custom-css">
			.about-area .thumb .overlay {
    position: absolute;
    right: 30px;
    bottom: 30px;
    max-width: 250px;
    background: #fe0000db;
    text-align: center;
    padding: 50px;
    outline: 1px dashed rgba(255, 255, 255, 0.6);
    outline-offset: -15px;
}

.top-bar-area .info li i {
    margin-right: 5px;
    color: rgb(217 89 89);
}

.attr-nav > ul > li.button a {
    background: rgb(255 0 0);
    color: rgb(255, 255, 255);
}

.about-area .info > h5 {
    color: rgb(255 0 0);
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 25px;
}

h2.text-blur {
    position: absolute;
    top: -50px;
    font-size: 120px;
    opacity: 0.08;
    line-height: 1;
    color: rgb(207 93 59);
    z-index: -1;
    font-weight: 700;
}

.btn-theme.border {
    background-color: transparent;
    color: rgb(35, 35, 35) !important;
    border: 2px solid rgb(255,0,0) !important;
}

.btn-theme.border:hover {
    background-color: rgb(255 0 0 / 1);
    border: 2px solid rgb(59, 207, 147);
    color: rgb(255, 255, 255) !important;
}

.btn-gradient::after {
    position: absolute;
    left: 0px;
    top: 0px;
    content: "";
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, rgb(221 36 7) 0%, rgb(174 5 5) 100%);
    transition: all 0.35s ease-in-out 0s;
    z-index: -1;
    box-shadow: rgb(255 136 0 / 50%) 0px 0px 10px, rgb(209 21 21) 0px 0px 1px 1px inset;
}

.causes-area .causes-items .progress .progress-bar {
    background: rgb(255 0 0);
    position: relative;
    z-index: 1;
    overflow: inherit;
}

.causes-area .causes-items .progress .progress-bar span {
    position: absolute;
    right: -22px;
    top: -43px;
    background: rgb(255 0 0);
    display: inline-block;
    padding: 0px 10px;
    border-radius: 5px;
    font-weight: 800;
}

.causes-area .causes-items .progress .progress-bar span::after {
    position: absolute;
    left: 50%;
    bottom: -5px;
    content: "";
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid rgb(255 0 0);
    margin-left: -5px;
}

.bg-gray {
    background-color: rgb(253 243 243);
}

.site-heading h5 {
    text-transform: uppercase;
    font-weight: 800;
    color: rgb(255 0 0);
    font-size: 18px;
    position: relative;
    z-index: 1;
    display: inline-block;
}

.heading-divider {
    display: inline-block;
    position: relative;
    height: 5px;
    border-radius: 30px;
    background-color: rgb(255 0 0);
    width: 90px;
    overflow: hidden;
}

.we-do-area .single-item:first-child .item i {
    color: rgb(237, 75, 75);
    display: none;
}

.we-do-area .item i {
    display: none;
    font-size: 60px;
    margin-bottom: 30px;
    color: rgb(59, 207, 147);
    position: relative;
    z-index: 1;
    padding: 10px;
}

.causes-area .causes-items .progress {
    height: 5px;
    overflow: inherit;
    margin-top: 60px;
    display: none;
}

.causes-area .causes-items .progress-box p {
    font-weight: 700;
    margin-top: 15px;
    margin-bottom: 0px;
    color: rgb(35, 35, 35);
    display: none;
}

.causes-area .causes-items .recent-causes-carousel.owl-carousel .owl-dot.active span::after {
    position: absolute;
    left: 50%;
    top: 50%;
    content: "";
    height: 5px;
    width: 5px;
    transform: translate(-50%, -50%);
    background: rgb(255 0 0);
    border-radius: 50%;
}

.mission-area .info h5 {
    text-transform: uppercase;
    font-weight: 700;
    color: rgb(255 0 0);
    margin-bottom: 25px;
}

.mission-area ul li::after {
