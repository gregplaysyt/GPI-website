    border: 2px solid rgb(255 0 0);
    color: rgb(255, 255, 255);
}

.donation-area form input.btn-theme {
    background-color: rgb(255 0 0);
    border: 2px solid rgb(255 0 0);
}

.donation-area .info .question .icon i {
