    border-radius: 50%;
    margin-right: 35px;
    position: relative;
    z-index: 1;
    margin-left: 15px;
}

.donation-area .info .question .icon i::after {
    position: absolute;
    left: -15px;
    top: -15px;
    content: "";
    height: 80px;
    width: 80px;
