                e.preventDefault();

                let email = $('#hd-sub-email').val();

                $.post('https://www.gpinigeria.org/wp-admin/admin-ajax.php', {
                    action: 'hd_subscribe',
                    email: email,
                    nonce: '95e2c56b5b'
                }, function(res){
                    $('.hd-msg').text(res.data);
                });
            });
        });
        </script>

                <button id="hd-popup-close" style="
            margin-top:8px;
            background:none;
            border:none;
            color:#999;
            cursor:pointer;
        ">Close</button>
    </div>
        <script>
    document.addEventListener('DOMContentLoaded', function(){
    
        setTimeout(function(){
            var popup = document.getElementById('hd-popup');
            if(popup){
                popup.style.display = 'block';
            }
        }, 8000);
    
        document.addEventListener('click', function(e){
            if(e.target && e.target.id === 'hd-popup-close'){
                document.getElementById('hd-popup').style.display = 'none';
            }
        });
    
    });
    </script>
